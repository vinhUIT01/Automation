# Copy to .env and fill in real values. .env is git-ignored by default.
# These variables are consumed by the monitoring stack and orchestration
# playbooks.

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-now

# --- Pushgateway / Prometheus ---
PUSHGATEWAY_URL=http://localhost:9091
PROMETHEUS_URL=http://localhost:9090

# --- SSH credentials for target docker hosts (used by ansible) ---
ANSIBLE_REMOTE_USER=ubuntu
ANSIBLE_PRIVATE_KEY_FILE=~/.ssh/id_rsa

# --- Optional: Slack / Teams webhook for alert routing ---
ALERT_WEBHOOK_URL=
